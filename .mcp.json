{
  "mcpServers": {
    "agent-toolkit": {
      "transport": "stdio",
      "enabled": true,
      "command": "npx",
      "args": ["-y", "@gtpshax/agent-toolkit@latest", "mcp"]
    },
    "exa": {
      "transport": "http",
      "enabled": true,
      "url": "https://mcp.exa.ai/mcp",
      "headers": {
        "x-api-key": "${EXA_API_KEY}"
      }
    }
  }
}
